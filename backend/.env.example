# ─────────────────────────────────────────────────────────────────────────────
# HeritageAI Backend — Environment Variables
# Copy this file to .env and fill in your values
# ─────────────────────────────────────────────────────────────────────────────

# HuggingFace token (optional — only needed for Stable Diffusion inpainting)
# Get a free token at: https://huggingface.co/settings/tokens
# LaMa inpainting works WITHOUT this token.
HUGGINGFACE_TOKEN=hf_your_token_here

# Default inpainting model: "lama" (recommended), "sd", or "classical"
DEFAULT_MODEL=lama

# Storage directories (relative to backend/ folder)
UPLOAD_DIR=storage/uploads
MASK_DIR=storage/masks
RESULT_DIR=storage/results
WEIGHTS_DIR=weights

# Maximum upload file size in MB
MAX_FILE_SIZE_MB=20

# Allowed CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# SQLite database file
DATABASE_URL=sqlite:///./heritageai.db
